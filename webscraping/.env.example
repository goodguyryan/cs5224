# Lambda application settings. Replace with your S3 bucket names.
# Use bucket names only: no s3:// prefix or HTTPS URL.
RAW_BUCKET=replace-with-your-raw-bucket-name
PROCESSED_BUCKET=replace-with-your-processed-bucket-name

# Lambda does not load this file automatically.
# Set the two values under Lambda Configuration > Environment variables,
# Both values may be the same bucket if using separate raw/ and processed/ prefixes.
