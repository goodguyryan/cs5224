# Lambda application settings for the summary and digest handlers.
# Use names only: no s3:// prefix, ARN, or HTTPS URL.
PROCESSED_BUCKET=replace-with-your-processed-bucket-name
REVIEW_TABLE=replace-with-your-review-table-name
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_INFERENCE_PROFILE=apac.amazon.nova-lite-v1:0
# Optional second check of each cited claim by the model: true or false.
CITATION_MODEL_CHECK=false

# Only scripts/approve_week.py publishes, so only it needs the reader's names.
DYNAMODB_TABLE_NAME=replace-with-approved-reports-table
S3_SUMMARY_BUCKET=replace-with-summary-bucket

# Lambda sets AWS_REGION itself; set it in your shell for local scripts.
# AWS_REGION=ap-southeast-1
